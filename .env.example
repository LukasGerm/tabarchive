# Required: use a long, unique password (at least 16 characters).
ARCHIVE_PASSWORD=
# Required: generate with: openssl rand -hex 32
SESSION_SECRET=
# Set to the actual HTTPS origin when deploying behind a reverse proxy.
APP_ORIGIN=http://127.0.0.1:3000
# Private persistent directory; never put this under public/ or commit it.
ARCHIVE_DATA_DIR=.data
# For Docker Compose with Caddy, set your public hostname (no scheme or path):
# ARCHIVE_DOMAIN=tabs.example.com

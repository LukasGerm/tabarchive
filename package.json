{
  "name": "music-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter tabarchive dev",
    "dev:trainer": "pnpm --filter musictrainer dev",
    "setup": "pnpm --filter tabarchive run setup",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:browser": "pnpm -r --workspace-concurrency=1 test:browser",
    "test:production": "pnpm --filter tabarchive test:production",
    "backup": "pnpm --filter tabarchive backup",
    "start": "pnpm --filter tabarchive start"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
